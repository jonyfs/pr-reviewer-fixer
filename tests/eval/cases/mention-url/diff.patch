@@ -0,0 +1,12 @@
+import re
+
+
+def wrap_mentions(text):
+    """Wrap a bare @login in backticks so posting the text notifies nobody."""
+    out = []
+    for line in text.split("\n"):
+        parts = line.split("`")
+        for i in range(0, len(parts), 2):
+            parts[i] = re.sub(r"(?<![\w`@])@([A-Za-z0-9-]+)", r"`@\1`", parts[i])
+        out.append("`".join(parts))
+    return "\n".join(out)
