diff --git a/port.ts b/port.ts
new file mode 100644
--- /dev/null
+++ b/port.ts
@@ -0,0 +1,7 @@
+export function parsePort(raw: string): number {
+  const n = Number(raw);
+  if (!Number.isInteger(n) || n < 1 || n > 65535) {
+    throw new RangeError(`invalid port: ${raw}`);
+  }
+  return n;
+}
diff --git a/port.test.ts b/port.test.ts
