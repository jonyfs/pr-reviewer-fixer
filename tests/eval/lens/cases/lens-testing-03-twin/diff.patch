@@ -0,0 +1,9 @@
+import { parsePort } from './port';
+
+it('parses a valid port', () => {
+  expect(parsePort('8080')).toBe(8080);
+});
+
+it('rejects an out-of-range port', () => {
+  expect(() => parsePort('70000')).toThrow(RangeError);
+});
