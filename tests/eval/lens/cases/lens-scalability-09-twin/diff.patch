+package reports
+
+class TenantTotals(private val repo: EventRepo) {
+
+    fun totalsByType(tenantId: String): Map<String, Long> {
+        val rows = repo.sumAmountGroupedByType(tenantId)
+        return rows.associate { it.type to it.total }
+            .toMap()
+    }
+}
