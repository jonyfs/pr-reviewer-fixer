+using System;
+using Microsoft.Extensions.Caching.Memory;
+
+namespace Example.Profiles;
+
+public class ProfileCache
+{
+    private readonly IMemoryCache _cache;
+    public ProfileCache(IMemoryCache cache) => _cache = cache;
+
+    public void Put(Profile profile)
+    {
+        _cache.Set($"profile:{profile.Id}", profile, TimeSpan.FromMinutes(10));
+    }
+
+    public Profile? Get(string id) => _cache.TryGetValue($"profile:{id}", out Profile? p) ? p : null;
+}
+
+public record Profile(string Id, string Email, string Phone, string Address);
