--- /dev/null
+++ b/src/counter.rs
@@ -0,0 +1,19 @@
+use std::thread;
+
+static mut COUNT: usize = 0;
+
+pub fn count_all(workers: usize, per_worker: usize) -> usize {
+    let handles: Vec<_> = (0..workers)
+        .map(|_| {
+            thread::spawn(move || {
+                for _ in 0..per_worker {
+                    unsafe { COUNT += 1; }
+                }
+            })
+        })
+        .collect();
+    for h in handles {
+        h.join().unwrap();
+    }
+    unsafe { COUNT }
+}
