--- /dev/null
+++ b/src/wallet.js
@@ -0,0 +1,23 @@
+let balance = 100;
+let queue = Promise.resolve();
+
+async function fetchFee(amount) {
+  const res = await fetch(`https://example.com/fee?amount=${amount}`);
+  return (await res.json()).fee;
+}
+
+function charge(amount) {
+  const run = queue.then(async () => {
+  const fee = await fetchFee(amount);
+  balance = balance - amount - fee;
+  return balance;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+function getBalance() {
+  return balance;
+}
+
+module.exports = { charge, getBalance };
