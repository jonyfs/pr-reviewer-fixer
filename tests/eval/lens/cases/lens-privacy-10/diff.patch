diff --git a/Sources/Backup/ContactBackup.swift b/Sources/Backup/ContactBackup.swift
new file mode 100644
--- /dev/null
+++ b/Sources/Backup/ContactBackup.swift
@@ -0,0 +1,13 @@
+import Foundation
+
+struct Contact: Codable {
+    let name: String
+    let email: String
+    let phone: String
+}
+
+func backUp(_ contacts: [Contact]) throws {
+    let data = try JSONEncoder().encode(contacts)
+    let url = URL(fileURLWithPath: "/Users/Shared/backups/contacts.json")
+    try data.write(to: url)
+}
