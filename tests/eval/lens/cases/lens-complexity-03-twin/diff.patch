--- /dev/null
+++ b/src/documents.ts
@@ -0,0 +1,14 @@
+interface Doc {
+  id: string;
+  body: string;
+  status: string;
+}
+
+export function publishDocument(doc: Doc): Doc {
+  return { ...doc, status: "published", body: doc.body.trim() };
+}
+
+export function archiveDocument(doc: Doc): Doc {
+  const stamp = new Date(0).toISOString();
+  return { ...doc, status: "archived", body: `${doc.body}\n<!-- ${stamp} -->` };
+}
