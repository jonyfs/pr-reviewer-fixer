@@ -0,0 +1,13 @@
+import { db } from "../db";
+
+export interface DeleteResult {
+  id: string;
+  deletedAt: Date;
+}
+
+export async function deleteUser(id: string): Promise<DeleteResult> {
+  const deletedAt = new Date();
+  await db.users.update(id, { deletedAt });
+  await db.sessions.deleteMany({ userId: id });
+  return { id, deletedAt };
+}
