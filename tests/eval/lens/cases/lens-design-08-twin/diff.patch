@@ -0,0 +1,15 @@
+<?php
+namespace App\Domain;
+
+final class ShippingQuote
+{
+    private const PER_KG = 4.5;
+
+    public function quote(array $parcel, string $country): float
+    {
+        $country = strtoupper($country);
+        $weight = array_sum(array_column($parcel, 'kg'));
+        $base = $weight * self::PER_KG;
+        return $country === 'US' ? $base : $base * 1.8;
+    }
+}
