+namespace Shop.Pricing;
+
+public class BankersRounder
+{
+    public decimal Round(decimal v) => Math.Round(v, 2, MidpointRounding.ToEven);
+}
+
+public static class RounderRegistry
+{
+    private static readonly Dictionary<string, Func<BankersRounder>> Factories = new();
+    public static void Register(string name, Func<BankersRounder> f) => Factories[name] = f;
+    public static BankersRounder Resolve(string name) => Factories[name]();
+}
+
+public class PriceFormatter
+{
+    static PriceFormatter() => RounderRegistry.Register("bankers", () => new BankersRounder());
+
+    public string Format(decimal v) =>
+        RounderRegistry.Resolve("bankers").Round(v).ToString("F2");
+}
