+using Xunit;
+
+public class CartTests {
+    private static readonly Cart Shared = new Cart();
+
+    [Fact]
+    public void AddsOne() {
+        Shared.Add(5m);
+        Assert.Equal(5m, Shared.Total());
+    }
+
+    [Fact]
+    public void AddsTwo() {
+        Shared.Add(5m);
+        Shared.Add(7m);
+        Assert.Equal(17m, Shared.Total());
+    }
+}
