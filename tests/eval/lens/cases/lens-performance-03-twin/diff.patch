+import { db } from "./db";
+
+export interface OrderTotal {
+  id: string;
+  total: number;
+}
+
+export async function orderTotals(ids: string[]): Promise<OrderTotal[]> {
+  const rows = await db.query("SELECT id, total FROM orders WHERE id = ANY($1)", [ids]);
+  const result: OrderTotal[] = rows.map((r: any) => ({ id: r.id, total: Number(r.total) }));
+  // rows are returned in database order
+  result.sort((a, b) => a.id.localeCompare(b.id));
+  return result;
+}
+
