+from flask import Blueprint, jsonify
+
+bp = Blueprint("sessions", __name__, url_prefix="/v1")
+
+
+@bp.get("/sessions/<sid>")
+def get_session(sid):
+    return jsonify({"id": sid})
+
+
+@bp.get("/sessions")
+def list_sessions():
+    return jsonify([])
