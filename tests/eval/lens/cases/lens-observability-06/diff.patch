+public class ReportService
+{
+    public async Task<Report> BuildAsync(int id)
+    {
+        var sw = Stopwatch.StartNew();
+        try
+        {
+            var report = await _repo.LoadAsync(id);
+            _metrics.Record("report.build_ms", sw.ElapsedMilliseconds);
+            return report;
+        }
+        catch (TimeoutException)
+        {
+            _log.LogWarning("report {Id} timed out", id);
+            throw;
+        }
+        finally
+        {
+            _log.LogDebug("build finished {Id}", id);
+        }
+    }
+}
