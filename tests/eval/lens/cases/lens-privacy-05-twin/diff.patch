+package com.example.events;
+
+import java.util.HashMap;
+import java.util.Map;
+
+public final class PageViewEvent {
+    public static Map<String, Object> build(String path, String sessionId, String ip, Geo geo) {
+        Map<String, Object> event = new HashMap<>();
+        event.put("type", "page_view");
+        event.put("path", path);
+        event.put("session", sessionId);
+        event.put("region", geo.region(ip));
+        return event;
+    }
+
+    public interface Geo { String region(String ip); }
+}
