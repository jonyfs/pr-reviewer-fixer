@@ -0,0 +1,15 @@
+import kotlinx.coroutines.*
+
+class Collector {
+    private val results = ArrayList<String>()
+
+    suspend fun collect(ids: List<Int>, fetch: suspend (Int) -> String): List<String> =
+        coroutineScope {
+            ids.map { id ->
+                launch(Dispatchers.Default) {
+                    results.add(fetch(id))
+                }
+            }.joinAll()
+            results.toList()
+        }
+}
