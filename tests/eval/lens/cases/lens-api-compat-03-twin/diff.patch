--- /dev/null
+++ b/src/orders/status.ts
@@ -0,0 +1,18 @@
+export type OrderStatus = "pending" | "paid" | "shipped" | "archived";
+
+export function statusLabel(s: OrderStatus): string {
+  switch (s) {
+    case "pending":
+      return "Awaiting payment";
+    case "paid":
+      return "Paid";
+    case "shipped":
+      return "On the way";
+    case "archived":
+      return "Archived";
+  }
+}
+
+export function isOpen(s: OrderStatus): boolean {
+  return s === "pending" || s === "paid";
+}
