--- /dev/null
+++ b/src/stock.js
@@ -0,0 +1,13 @@
+const log = require('./log');
+
+async function syncInventory(client, sku) {
+  try {
+    const stock = await client.fetchStock(sku);
+    return stock.count;
+  } catch (err) {
+    log.error(err.message);
+    return null;
+  }
+}
+
+module.exports = { syncInventory };
