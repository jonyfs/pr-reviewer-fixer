+package example;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+public class LoginService {
+    private static final Logger log = LoggerFactory.getLogger(LoginService.class);
+
+    public boolean login(Account account, String attempt) {
+        if (account.isLocked()) {
+            log.debug("login rejected, account locked id={}", account.getId());
+            return false;
+        }
+        return account.check(attempt);
+    }
+}
