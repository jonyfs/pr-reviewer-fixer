+using System.Collections.Generic;
+using System.Linq;
+
+namespace Example.Events;
+
+public class EventQuery
+{
+    private readonly EventContext _db;
+
+    public EventQuery(EventContext db) => _db = db;
+
+    public List<Event> Recent(string tenantId)
+    {
+        return _db.Events.ToList().Where(e => e.TenantId == tenantId)
+            .OrderByDescending(e => e.CreatedAt)
+            .Take(100).ToList();
+    }
+}
