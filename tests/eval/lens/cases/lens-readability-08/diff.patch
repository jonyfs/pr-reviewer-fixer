+function summarize(array $rows): array
+{
+    $startedAt = microtime(true);
+    $total = 0;
+    foreach ($rows as $row) {
+        $total += $row['amount'];
+    }
+    return [
+        'count' => count($rows),
+        'total' => $total,
+    ];
+}
