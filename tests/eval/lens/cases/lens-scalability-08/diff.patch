+<?php
+
+namespace App\Readings;
+
+use Aws\DynamoDb\DynamoDbClient;
+
+class Writer
+{
+    public function __construct(private DynamoDbClient $db) {}
+
+    public function save(string $sensorId, float $value): void
+    {
+        $pk = gmdate('Y-m-d\TH:i:s') . '#' . $sensorId;
+        $this->db->putItem([
+            'TableName' => 'readings',
+            'Item' => [
+                'pk' => ['S' => $pk],
+                'value' => ['N' => (string) $value],
+            ],
+        ]);
+    }
+}
