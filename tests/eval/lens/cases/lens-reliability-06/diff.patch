+using System;
+using System.IO;
+using System.Threading;
+using System.Threading.Tasks;
+
+public class ReportExporter
+{
+    private readonly SemaphoreSlim _slots = new(4);
+    private readonly IBlobStore _store;
+
+    public ReportExporter(IBlobStore store) => _store = store;
+
+    public async Task ExportAsync(Report report, CancellationToken ct)
+    {
+        await _slots.WaitAsync(ct);
+        var tmp = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}.csv");
+        try
+        {
+            await File.WriteAllTextAsync(tmp, report.ToCsv(), ct);
+            await _store.UploadAsync(report.Name, tmp, ct);
+            File.Delete(tmp);
+        }
+        finally
+        {
+            _slots.Release();
+        }
+    }
+}
