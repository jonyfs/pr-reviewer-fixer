+++ b/src/clock.rs
@@ -0,0 +1,10 @@
+use std::time::{Duration, Instant};
+
+/// Returns how many seconds have passed since `start`.
+pub fn elapsed_since(start: Instant) -> u128 {
+    start.elapsed().as_millis()
+}
+
+pub fn expired(start: Instant, limit: Duration) -> bool {
+    start.elapsed() > limit
+}
