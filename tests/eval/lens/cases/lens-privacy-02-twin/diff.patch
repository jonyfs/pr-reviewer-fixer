diff --git a/src/checkout/track.js b/src/checkout/track.js
new file mode 100644
--- /dev/null
+++ b/src/checkout/track.js
@@ -0,0 +1,14 @@
+import analytics from "@vendor/analytics-sdk";
+
+const STEPS = ["cart", "address", "payment", "confirm"];
+
+export function trackStep(customer, step) {
+  if (!STEPS.includes(step)) {
+    return;
+  }
+  analytics.track("checkout_step", { step, customerId: customer.id });
+}
+
+export function trackDone(customer, orderId) {
+  analytics.track("checkout_done", { orderId, customerId: customer.id });
+}
