+package com.example.report;
+
+import java.util.List;
+
+public class CsvReport {
+    public record Row(String account, long units) {}
+
+    public String render(List<Row> rows) {
+        StringBuilder out = new StringBuilder("account,units\n");
+        for (Row row : rows) {
+            out.append(row.account()).append(',').append(row.units()).append('\n');
+        }
+        return out.toString();
+    }
+}
