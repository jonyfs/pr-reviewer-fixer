+package reports
+
+class TenantTotals(private val repo: EventRepo) {
+
+    fun totalsByType(tenantId: String): Map<String, Long> {
+        val events = repo.findAllByTenant(tenantId)
+        return events.groupBy { it.type }
+            .mapValues { (_, list) -> list.sumOf { it.amount } }
+    }
+}
