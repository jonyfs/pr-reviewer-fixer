--- /dev/null
+++ b/src/documents.ts
@@ -0,0 +1,13 @@
+interface Doc {
+  id: string;
+  body: string;
+  status: string;
+}
+
+export function saveDocument(doc: Doc, isPublish: boolean): Doc {
+  if (isPublish) {
+    return { ...doc, status: "published", body: doc.body.trim() };
+  }
+  const stamp = new Date(0).toISOString();
+  return { ...doc, status: "archived", body: `${doc.body}\n<!-- ${stamp} -->` };
+}
