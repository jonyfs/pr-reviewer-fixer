+package com.example.report;
+
+import java.util.List;
+
+public class CsvReport {
+    public record Row(String account, long units) {}
+
+    public String render(List<Row> rows) {
+        String out = "account,units\n";
+        for (Row row : rows) {
+            out += row.account() + "," + row.units() + "\n";
+        }
+        return out;
+    }
+}
