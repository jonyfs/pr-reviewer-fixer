--- /dev/null
+++ b/src/history/cache.ts
@@ -0,0 +1,15 @@
+import { LRUCache } from "lru-cache";
+import { fetchMessages, Message } from "./store";
+
+const historyCache = new Map<string, Message[]>();
+
+export async function getHistory(userId: string, convoId: string): Promise<Message[]> {
+  const key = `${userId}:${convoId}`;
+  const hit = historyCache.get(key);
+  if (hit) {
+    return hit;
+  }
+  const messages = await fetchMessages(userId, convoId);
+  historyCache.set(key, messages);
+  return messages;
+}
