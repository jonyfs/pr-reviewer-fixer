@@ -0,0 +1,20 @@
+public class Currencies {
+    public static String forCountry(String code) {
+        if (code.equals("US")) {
+            return "USD";
+        } else if (code.equals("CA")) {
+            return "CAD";
+        } else if (code.equals("MX")) {
+            return "MXN";
+        } else if (code.equals("BR")) {
+            return "BRL";
+        } else if (code.equals("JP")) {
+            return "JPY";
+        } else if (code.equals("GB")) {
+            return "GBP";
+        } else if (code.equals("CH")) {
+            return "CHF";
+        }
+        return "EUR";
+    }
+}
