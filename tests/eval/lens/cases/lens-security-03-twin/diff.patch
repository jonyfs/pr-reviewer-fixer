@@ -0,0 +1,12 @@
+package web
+
+import ("net/http"; "strings")
+
+func Login(w http.ResponseWriter, r *http.Request) {
+	if !authenticate(r) {
+		http.Error(w, "denied", http.StatusUnauthorized)
+		return
+	}
+	next := "/" + strings.TrimLeft(r.URL.Query().Get("next"), "/\\")
+	http.Redirect(w, r, next, http.StatusFound)
+}
