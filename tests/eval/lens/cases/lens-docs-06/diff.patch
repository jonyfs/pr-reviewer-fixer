--- /dev/null
+++ b/bin/export.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Export the report tables to CSV files.
+usage() {
+  echo "usage: export.sh [--out DIR] [--table NAME]"
+  exit 2
+}
+
+OUTPUT="."
+TABLE="all"
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output) OUTPUT="$2"; shift 2 ;;
+    --table) TABLE="$2"; shift 2 ;;
+    *) usage ;;
+  esac
+done
+mkdir -p "$OUTPUT"
+echo "exporting $TABLE to $OUTPUT"
