+package example;
+
+import java.io.*;
+
+public class SessionLoader {
+    public Session load(InputStream body) throws Exception {
+        ObjectInputStream ois = new ObjectInputStream(body); ois.setObjectInputFilter(ObjectInputFilter.Config.createFilter("example.Session;!*"));
+        return (Session) ois.readObject();
+    }
+}
