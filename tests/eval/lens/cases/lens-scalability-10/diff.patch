--- /dev/null
+++ b/src/jobs.rs
@@ -0,0 +1,16 @@
+use std::time::Duration;
+
+pub async fn wait_for_job(client: &Client, id: &str) -> Result<Job, Error> {
+    let mut attempts = 0u32;
+    loop {
+        let job = client.get_job(id).await?;
+        if job.done {
+            return Ok(job);
+        }
+        tokio::time::sleep(Duration::from_millis(100)).await;
+        attempts += 1;
+        if attempts > 6000 {
+            return Err(Error::Timeout);
+        }
+    }
+}
