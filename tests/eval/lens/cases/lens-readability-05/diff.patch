+import java.util.Objects;
+
+public class Greeter {
+    public String greet(String name) {
+        name = Objects.requireNonNull(name);
+        if (name == null) {
+            return "";
+        }
+        return "Hello, " + name.trim() + "!";
+    }
+
+    public String shout(String name) {
+        return greet(name).toUpperCase();
+    }
+}
