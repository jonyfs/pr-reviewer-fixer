--- /dev/null
+++ b/src/lib.rs
@@ -0,0 +1,18 @@
+pub fn render(name: &str) -> String {
+    format!("<h1>{}</h1>", name)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn renders_heading() {
+        assert_eq!(render("Ana"), "<h1>Ana</h1>");
+    }
+
+    #[test]
+    fn renders_empty() {
+        assert_eq!(render(""), "<h1></h1>");
+    }
+}
