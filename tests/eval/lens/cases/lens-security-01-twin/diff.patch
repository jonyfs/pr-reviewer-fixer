@@ -0,0 +1,11 @@
+from werkzeug.security import safe_join
+from flask import Flask, request, send_file, abort
+
+app = Flask(__name__)
+UPLOAD_DIR = "/srv/app/uploads"
+
+@app.get("/files")
+def download():
+    name = request.args["name"]
+    path = safe_join(UPLOAD_DIR, name) or abort(404)
+    return send_file(path)
