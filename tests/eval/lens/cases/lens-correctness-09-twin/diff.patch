+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace Billing
+{
+    public static class Totals
+    {
+        public static bool Matches(IEnumerable<double> lines, double expected)
+        {
+            double sum = lines.Sum();
+            return Math.Abs(sum - expected) < 1e-9;
+        }
+
+        public static string Describe(IEnumerable<double> lines, double expected)
+        {
+            return Matches(lines, expected) ? "balanced" : "mismatch";
+        }
+    }
+}
