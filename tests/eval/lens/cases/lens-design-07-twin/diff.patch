+package shop.cart
+
+import shop.model.Item
+import shop.pricing.PricingService
+
+class Cart(val items: MutableList<Item> = mutableListOf()) {
+    private val pricing = PricingService()
+    fun total(): Long = pricing.total(items)
+}
diff --git a/src/main/kotlin/shop/pricing/PricingService.kt b/src/main/kotlin/shop/pricing/PricingService.kt
new file mode 100644
--- /dev/null
