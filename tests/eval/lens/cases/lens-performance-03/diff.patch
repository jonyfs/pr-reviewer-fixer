+import { db } from "./db";
+
+export interface OrderTotal {
+  id: string;
+  total: number;
+}
+
+export async function orderTotals(ids: string[]): Promise<OrderTotal[]> {
+  const result: OrderTotal[] = [];
+  for (const id of ids) {
+    const rows = await db.query("SELECT id, total FROM orders WHERE id = $1", [id]);
+    result.push({ id, total: Number(rows[0].total) });
+  }
+  return result;
+}
