+import Foundation
+
+func sum(_ values: [Int]) -> Int {
+    var total = 0
+    let lock = NSLock()
+    DispatchQueue.concurrentPerform(iterations: values.count) { i in
+        lock.withLock { total += values[i] }
+    }
+    return total
+}
