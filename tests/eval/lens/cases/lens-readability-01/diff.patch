+import sqlite3
+
+
+def get_user_sessions(conn, user_id):
+    cur = conn.cursor()
+    cur.execute("DELETE FROM sessions WHERE user_id = ? AND expires_at < datetime('now')", (user_id,))
+    removed = cur.rowcount
+    conn.commit()
+    return removed
+
+
+def count_sessions(conn, user_id):
+    cur = conn.cursor()
+    cur.execute("SELECT COUNT(*) FROM sessions WHERE user_id = ?", (user_id,))
+    return cur.fetchone()[0]
