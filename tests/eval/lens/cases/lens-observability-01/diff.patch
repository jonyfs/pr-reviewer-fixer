+import logging
+
+logger = logging.getLogger(__name__)
+
+
+def charge(gateway, order):
+    try:
+        gateway.capture(order.id, order.total_cents)
+    except TimeoutError:
+        return False
+    logger.info("charged order=%s", order.id)
+    return True
