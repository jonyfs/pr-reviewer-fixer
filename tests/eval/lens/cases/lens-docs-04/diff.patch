+import argparse
+
+
+def build_parser():
+    p = argparse.ArgumentParser(prog="tool")
+    p.add_argument("input")
+    p.add_argument("--format", choices=["json", "csv"], default="json")
+    p.add_argument("--verbose", action="store_true")
+    return p
+
+
+def main(argv=None):
+    args = build_parser().parse_args(argv)
+    return args
