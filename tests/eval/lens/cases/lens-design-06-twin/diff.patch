+namespace Shop.Pricing;
+
+public class BankersRounder
+{
+    public decimal Round(decimal v) => Math.Round(v, 2, MidpointRounding.ToEven);
+}
+
+public class PriceFormatter
+{
+    private readonly BankersRounder _rounder = new();
+
+    public string Format(decimal v) =>
+        _rounder.Round(v).ToString("F2");
+}
