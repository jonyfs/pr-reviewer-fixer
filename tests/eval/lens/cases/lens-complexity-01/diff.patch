+++ b/src/shipping.py
@@ -0,0 +1,17 @@
+def shipping_cost(order, rates):
+    if order is not None:
+        if order.items:
+            if order.destination in rates:
+                if order.express:
+                    if order.weight > 20:
+                        return rates[order.destination] * 3
+                    else:
+                        return rates[order.destination] * 2
+                else:
+                    return rates[order.destination]
+            else:
+                raise KeyError(order.destination)
+        else:
+            return 0
+    else:
+        raise ValueError("no order")
